# P2 real-data mode. Set true only for the isolated P1 prototype.
DEMO_MODE=false
APP_ORIGIN=http://127.0.0.1:3000
AUTH_PROVIDER=supabase

# Server-only. Never paste these values into chat or commit .env.local.
DATABASE_URL=
MIGRATION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public signup stays disabled until age/consent/privacy policy is confirmed.
AUTH_ALLOW_SIGNUP=false
PRIVACY_POLICY_VERSION=

# Optional invitation email. Missing config is explicitly manual delivery.
RESEND_API_KEY=
MAIL_FROM=
