# P2 real-data mode. Set true only for the isolated P1 prototype.
DEMO_MODE=false
APP_ORIGIN=http://127.0.0.1:3000
AUTH_PROVIDER=supabase

# Server-only. Never paste these values into chat or commit .env.local.
DATABASE_URL=
MIGRATION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public signup stays disabled until age/consent/privacy policy is confirmed.
AUTH_ALLOW_SIGNUP=false
PRIVACY_POLICY_VERSION=

# Optional invitation email. Missing config is explicitly manual delivery.
RESEND_API_KEY=
MAIL_FROM=

# Zoom User-managed OAuth 2.0 & Webhook & Meeting SDK (Server-only secrets)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://127.0.0.1:3000/api/zoom/oauth/callback
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_TOKEN_ENCRYPTION_KEY=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
# Set true ONLY after Zoom Marketplace App Review approves external meeting SDK join (2026 policy).
ZOOM_EXTERNAL_SDK_APPROVED=false
ZOOM_API_BASE_URL=https://api.zoom.us/v2
ZOOM_OAUTH_BASE_URL=https://zoom.us/oauth
