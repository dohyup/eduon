# P2 real-data mode. Set true only for the isolated P1 prototype.
DEMO_MODE=false
APP_ORIGIN=http://127.0.0.1:3000
AUTH_PROVIDER=supabase

# Server-only. Never paste these values into chat or commit .env.local.
DATABASE_URL=
MIGRATION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public signup stays disabled until age/consent/privacy policy is confirmed.
AUTH_ALLOW_SIGNUP=false
PRIVACY_POLICY_VERSION=

# Optional invitation email. Missing config is explicitly manual delivery.
RESEND_API_KEY=
MAIL_FROM=

# P3: provider deferred. Keep real payment operations disabled.
# fake is accepted only in the isolated, explicitly guarded test environment.
PAYMENT_PROVIDER=
PAYMENT_MODE=test
# Internal scheduler HMAC secret, at least 32 characters; never send in URLs.
JOBS_SECRET=

# P4 remains off until 0003_learning has been applied to the chosen environment.
LEARNING_ENABLED=false
VIDEO_PROVIDER=daily
DAILY_API_KEY=
# Exact tenant host, without https:// or paths (example: your-school.daily.co).
DAILY_DOMAIN=
# Private storage and scanner adapters are pending; do not use fake with real DB.
STORAGE_PROVIDER=
# Explicit deployment gate. Preview is not a production release.
EDUON_DEPLOYMENT=preview
RETENTION_POLICY_VERSION=
SELLER_POLICY_VERSION=
REFUND_POLICY_VERSION=
CONSENT_POLICY_VERSION=
