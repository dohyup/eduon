generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  Attendance_authorId         Attendance[]         @relation("Attendance_authorId")
  AttendanceRevision_authorId AttendanceRevision[] @relation("AttendanceRevision_authorId")
  Material_uploaderId         Material[]           @relation("Material_uploaderId")
  Assignment_createdById      Assignment[]         @relation("Assignment_createdById")
  Feedback_authorId           Feedback[]           @relation("Feedback_authorId")
  Review_authorId             Review[]             @relation("Review_authorId")
  Review_moderatedById        Review[]             @relation("Review_moderatedById")
  ReviewReport_reporterId     ReviewReport[]       @relation("ReviewReport_reporterId")
  ReviewReport_resolvedById   ReviewReport[]       @relation("ReviewReport_resolvedById")
  AnalyticsEvent_actorId      AnalyticsEvent[]     @relation("AnalyticsEvent_actorId")

  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique
  platformAdmin         Boolean                @default(false)
  guardianVerifiedAt    DateTime?
  disabledAt            DateTime?
  createdAt             DateTime               @default(now())
  memberships           AcademyMembership[]
  guardianLinks         GuardianLink[]
  student               StudentProfile?
  assignments           InstructorAssignment[]
  studentInvitations    StudentInvitation[]
  instructorInvitations InstructorInvitation[]
  orders                Order[]
}

model Academy {
  Attendance_academyId     Attendance[]     @relation("Attendance_academyId")
  Material_academyId       Material[]       @relation("Material_academyId")
  Assignment_academyId     Assignment[]     @relation("Assignment_academyId")
  AnalyticsEvent_academyId AnalyticsEvent[] @relation("AnalyticsEvent_academyId")

  orders                Order[]
  settlementEntries     SettlementEntry[]
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  region                String
  status                String                 @default("draft")
  decisionReason        String?
  createdAt             DateTime               @default(now())
  memberships           AcademyMembership[]
  courses               Course[]
  offerings             Offering[]
  instructorInvitations InstructorInvitation[]

  @@index([status, createdAt])
}

model AcademyMembership {
  id        String  @id @default(uuid()) @db.Uuid
  academyId String  @db.Uuid
  userId    String  @db.Uuid
  role      String
  active    Boolean @default(true)
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([academyId, userId])
  @@index([userId, active])
}

model StudentProfile {
  Attendance_studentId    Attendance[] @relation("Attendance_studentId")
  Material_ownerStudentId Material[]   @relation("Material_ownerStudentId")
  Submission_studentId    Submission[] @relation("Submission_studentId")

  orders        Order[]
  id            String              @id @default(uuid()) @db.Uuid
  name          String
  grade         Int
  accountUserId String?             @unique @db.Uuid
  account       User?               @relation(fields: [accountUserId], references: [id], onDelete: Restrict)
  guardians     GuardianLink[]
  invitations   StudentInvitation[]
  enrollments   Enrollment[]
  createdAt     DateTime            @default(now())
}

model GuardianLink {
  id         String         @id @default(uuid()) @db.Uuid
  guardianId String         @db.Uuid
  studentId  String         @db.Uuid
  verifiedAt DateTime
  revokedAt  DateTime?
  guardian   User           @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([guardianId, studentId])
  @@index([studentId, revokedAt])
}

model StudentInvitation {
  id             String         @id @default(uuid()) @db.Uuid
  studentId      String         @db.Uuid
  issuedById     String         @db.Uuid
  recipientEmail String
  tokenHash      String         @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  issuer         User           @relation(fields: [issuedById], references: [id], onDelete: Restrict)

  @@index([studentId, expiresAt])
  @@index([issuedById])
}

model InstructorInvitation {
  issuedById     String    @db.Uuid
  issuer         User      @relation(fields: [issuedById], references: [id], onDelete: Restrict)
  id             String    @id @default(uuid()) @db.Uuid
  academyId      String    @db.Uuid
  recipientEmail String
  tokenHash      String    @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  academy        Academy   @relation(fields: [academyId], references: [id], onDelete: Restrict)

  @@index([academyId, expiresAt])
}

model Course {
  id        String     @id @default(uuid()) @db.Uuid
  academyId String     @db.Uuid
  title     String
  subject   String
  gradeMin  Int
  gradeMax  Int
  level     String
  academy   Academy    @relation(fields: [academyId], references: [id], onDelete: Restrict)
  offerings Offering[]

  @@unique([id, academyId])
  @@index([academyId])
}

model Offering {
  Attendance_offeringId     Attendance[]     @relation("Attendance_offeringId")
  Material_offeringId       Material[]       @relation("Material_offeringId")
  Assignment_offeringId     Assignment[]     @relation("Assignment_offeringId")
  Submission_offeringId     Submission[]     @relation("Submission_offeringId")
  AnalyticsEvent_offeringId AnalyticsEvent[] @relation("AnalyticsEvent_offeringId")

  orders             Order[]
  id                 String                 @id @default(uuid()) @db.Uuid
  courseId           String                 @db.Uuid
  academyId          String                 @db.Uuid
  status             String                 @default("draft")
  priceWon           Int
  capacity           Int
  enrollmentOpensAt  DateTime
  enrollmentClosesAt DateTime
  purchaseLockedAt   DateTime?
  createdAt          DateTime               @default(now())
  course             Course                 @relation(fields: [courseId, academyId], references: [id, academyId], onDelete: Restrict)
  academy            Academy                @relation(fields: [academyId], references: [id], onDelete: Restrict)
  sessions           Session[]
  instructors        InstructorAssignment[]
  enrollments        Enrollment[]

  @@unique([id, academyId])
  @@index([academyId, status])
  @@index([status, enrollmentClosesAt, id])
  @@index([courseId, academyId])
}

model Session {
  Attendance_sessionId Attendance[] @relation("Attendance_sessionId")
  Material_sessionId   Material[]   @relation("Material_sessionId")
  Assignment_sessionId Assignment[] @relation("Assignment_sessionId")

  enrollmentSessions EnrollmentSession[]
  id                 String              @id @default(uuid()) @db.Uuid
  offeringId         String              @db.Uuid
  academyId          String              @db.Uuid
  startsAt           DateTime
  endsAt             DateTime
  offering           Offering            @relation(fields: [offeringId, academyId], references: [id, academyId], onDelete: Restrict)

  @@index([offeringId, academyId])
  @@index([startsAt, endsAt])
}

model InstructorAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  offeringId String   @db.Uuid
  userId     String   @db.Uuid
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  instructor User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([offeringId, userId])
  @@index([userId])
}

model Enrollment {
  Attendance_enrollmentId     Attendance[]     @relation("Attendance_enrollmentId")
  Review_enrollmentId         Review?          @relation("Review_enrollmentId")
  AnalyticsEvent_enrollmentId AnalyticsEvent[] @relation("AnalyticsEvent_enrollmentId")

  orderId    String?             @unique @db.Uuid
  order      Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sessions   EnrollmentSession[]
  id         String              @id @default(uuid()) @db.Uuid
  offeringId String              @db.Uuid
  studentId  String              @db.Uuid
  status     String              @default("active")
  offering   Offering            @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  student    StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([offeringId, studentId])
  @@index([studentId, status])
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  action    String
  targetId  String
  reason    String?
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
}

model RateLimit {
  key       String   @id
  hits      Int
  expiresAt DateTime
}

model RecommendationEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @db.Uuid
  ruleVersion  String
  candidateIds String[]
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
}

model Order {
  AnalyticsEvent_orderId AnalyticsEvent[] @relation("AnalyticsEvent_orderId")

  id                String            @id @default(uuid()) @db.Uuid
  parentId          String            @db.Uuid
  studentId         String            @db.Uuid
  offeringId        String            @db.Uuid
  academyId         String            @db.Uuid
  requestKey        String
  status            String            @default("pending_payment")
  amountWon         Int
  currency          String            @default("KRW")
  feeWon            Int
  policyVersion     String
  policySnapshot    Json
  sessionsSnapshot  Json
  consentedAt       DateTime?
  expiresAt         DateTime
  exceptionReason   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  parent            User              @relation(fields: [parentId], references: [id], onDelete: Restrict)
  student           StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  offering          Offering          @relation(fields: [offeringId, academyId], references: [id, academyId], onDelete: Restrict)
  academy           Academy           @relation(fields: [academyId], references: [id], onDelete: Restrict)
  reservation       SeatReservation?
  enrollment        Enrollment?
  payment           Payment?
  refunds           Refund[]
  settlementEntries SettlementEntry[]

  @@unique([parentId, requestKey])
  @@unique([id, studentId, offeringId, academyId])
  @@index([parentId, createdAt, id])
  @@index([studentId, status])
  @@index([offeringId, academyId, status])
  @@index([status, expiresAt])
  @@index([academyId, status])
}

model SeatReservation {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @unique @db.Uuid
  studentId  String   @db.Uuid
  offeringId String   @db.Uuid
  academyId  String   @db.Uuid
  status     String   @default("held")
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId, studentId, offeringId, academyId], references: [id, studentId, offeringId, academyId], onDelete: Restrict)

  @@unique([orderId, studentId, offeringId, academyId])
  @@index([offeringId, status, expiresAt])
  @@index([studentId, status, expiresAt])
}

model EnrollmentSession {
  id           String          @id @default(uuid()) @db.Uuid
  enrollmentId String          @db.Uuid
  sessionId    String          @db.Uuid
  status       String          @default("allowed")
  startsAt     DateTime
  endsAt       DateTime
  amountWon    Int
  completedAt  DateTime?
  enrollment   Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  session      Session         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  refunds      RefundSession[]

  @@unique([enrollmentId, sessionId])
  @@index([sessionId])
}

model Payment {
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @unique @db.Uuid
  provider          String            @default("fake")
  transactionId     String            @unique
  amountWon         Int
  currency          String            @default("KRW")
  status            String            @default("pending")
  verifiedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds           Refund[]
  settlementEntries SettlementEntry[]

  @@index([status, updatedAt])
}

model Refund {
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @db.Uuid
  paymentId         String            @db.Uuid
  requestKey        String            @unique
  requestedById     String?           @db.Uuid
  kind              String            @default("customer")
  status            String            @default("requested")
  amountWon         Int
  reason            String
  providerReference String?
  attempts          Int               @default(0)
  lastError         String?
  succeededAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment           Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  sessions          RefundSession[]
  settlementEntries SettlementEntry[]

  @@index([orderId, status])
  @@index([paymentId, status])
  @@index([status, updatedAt])
}

model RefundSession {
  id                  String            @id @default(uuid()) @db.Uuid
  refundId            String            @db.Uuid
  enrollmentSessionId String            @db.Uuid
  refund              Refund            @relation(fields: [refundId], references: [id], onDelete: Restrict)
  enrollmentSession   EnrollmentSession @relation(fields: [enrollmentSessionId], references: [id], onDelete: Restrict)

  @@unique([refundId, enrollmentSessionId])
  @@index([enrollmentSessionId])
}

model ProviderEvent {
  id            String    @id @default(uuid()) @db.Uuid
  provider      String    @default("fake")
  eventId       String    @unique
  transactionId String
  status        String    @default("pending")
  payloadJson   Json
  attempts      Int       @default(0)
  lastError     String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([status, createdAt])
  @@index([transactionId])
}

model SettlementEntry {
  id                String            @id @default(uuid()) @db.Uuid
  academyId         String            @db.Uuid
  orderId           String            @db.Uuid
  paymentId         String?           @db.Uuid
  refundId          String?           @db.Uuid
  kind              String
  amountWon         Int
  currency          String            @default("KRW")
  idempotencyKey    String            @unique
  originalEntryId   String?           @db.Uuid
  externalReference String?
  recordedById      String?           @db.Uuid
  createdAt         DateTime          @default(now())
  academy           Academy           @relation(fields: [academyId], references: [id], onDelete: Restrict)
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment           Payment?          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund            Refund?           @relation(fields: [refundId], references: [id], onDelete: Restrict)
  originalEntry     SettlementEntry?  @relation("LedgerOriginal", fields: [originalEntryId], references: [id], onDelete: Restrict)
  adjustments       SettlementEntry[] @relation("LedgerOriginal")

  @@index([academyId, createdAt, id])
  @@index([orderId])
  @@index([paymentId])
  @@index([refundId])
  @@index([originalEntryId])
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  status      String    @default("pending")
  dedupeKey   String    @unique
  payloadJson Json
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  leaseUntil  DateTime?
  claimedBy   String?
  claimToken  String?   @db.Uuid
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([status, leaseUntil])
}

model Attendance {
  revisions AttendanceRevision[] @relation("AttendanceRevision_attendanceId")

  id           String         @id @default(uuid()) @db.Uuid
  academyId    String         @db.Uuid
  academy      Academy        @relation("Attendance_academyId", fields: [academyId], references: [id], onDelete: Restrict)
  offeringId   String         @db.Uuid
  offering     Offering       @relation("Attendance_offeringId", fields: [offeringId], references: [id], onDelete: Restrict)
  sessionId    String         @db.Uuid
  session      Session        @relation("Attendance_sessionId", fields: [sessionId], references: [id], onDelete: Restrict)
  enrollmentId String         @db.Uuid
  enrollment   Enrollment     @relation("Attendance_enrollmentId", fields: [enrollmentId], references: [id], onDelete: Restrict)
  studentId    String         @db.Uuid
  student      StudentProfile @relation("Attendance_studentId", fields: [studentId], references: [id], onDelete: Restrict)
  authorId     String         @db.Uuid
  author       User           @relation("Attendance_authorId", fields: [authorId], references: [id], onDelete: Restrict)
  status       String
  reason       String
  recordedAt   DateTime       @default(now())

  @@unique([sessionId, studentId])
  @@index([academyId])
  @@index([offeringId])
  @@index([sessionId])
  @@index([enrollmentId])
  @@index([studentId])
  @@index([authorId])
}

model AttendanceRevision {
  id           String     @id @default(uuid()) @db.Uuid
  attendanceId String     @db.Uuid
  attendance   Attendance @relation("AttendanceRevision_attendanceId", fields: [attendanceId], references: [id], onDelete: Restrict)
  authorId     String     @db.Uuid
  author       User       @relation("AttendanceRevision_authorId", fields: [authorId], references: [id], onDelete: Restrict)
  status       String
  reason       String
  createdAt    DateTime   @default(now())

  @@index([attendanceId])
  @@index([authorId])
}

model Material {
  SubmissionFile_materialId SubmissionFile[] @relation("SubmissionFile_materialId")

  id             String          @id @default(uuid()) @db.Uuid
  academyId      String          @db.Uuid
  academy        Academy         @relation("Material_academyId", fields: [academyId], references: [id], onDelete: Restrict)
  offeringId     String          @db.Uuid
  offering       Offering        @relation("Material_offeringId", fields: [offeringId], references: [id], onDelete: Restrict)
  sessionId      String?         @db.Uuid
  session        Session?        @relation("Material_sessionId", fields: [sessionId], references: [id], onDelete: Restrict)
  uploaderId     String          @db.Uuid
  uploader       User            @relation("Material_uploaderId", fields: [uploaderId], references: [id], onDelete: Restrict)
  ownerStudentId String?         @db.Uuid
  ownerStudent   StudentProfile? @relation("Material_ownerStudentId", fields: [ownerStudentId], references: [id], onDelete: Restrict)
  purpose        String
  objectKey      String          @unique
  filename       String
  mime           String
  bytes          Int
  sha256         String
  scanStatus     String          @default("quarantined")
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())

  @@index([academyId])
  @@index([offeringId])
  @@index([sessionId])
  @@index([uploaderId])
  @@index([ownerStudentId])
}

model Assignment {
  submissions Submission[] @relation("Submission_assignmentId")

  id           String   @id @default(uuid()) @db.Uuid
  academyId    String   @db.Uuid
  academy      Academy  @relation("Assignment_academyId", fields: [academyId], references: [id], onDelete: Restrict)
  offeringId   String   @db.Uuid
  offering     Offering @relation("Assignment_offeringId", fields: [offeringId], references: [id], onDelete: Restrict)
  sessionId    String?  @db.Uuid
  session      Session? @relation("Assignment_sessionId", fields: [sessionId], references: [id], onDelete: Restrict)
  title        String
  instructions String
  dueAt        DateTime
  createdById  String   @db.Uuid
  creator      User     @relation("Assignment_createdById", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([academyId])
  @@index([offeringId])
  @@index([sessionId])
  @@index([createdById])
}

model Submission {
  files    SubmissionFile[] @relation("SubmissionFile_submissionId")
  feedback Feedback[]       @relation("Feedback_submissionId")

  id           String         @id @default(uuid()) @db.Uuid
  academyId    String         @db.Uuid
  offeringId   String         @db.Uuid
  offering     Offering       @relation("Submission_offeringId", fields: [offeringId], references: [id], onDelete: Restrict)
  assignmentId String         @db.Uuid
  assignment   Assignment     @relation("Submission_assignmentId", fields: [assignmentId], references: [id], onDelete: Restrict)
  studentId    String         @db.Uuid
  student      StudentProfile @relation("Submission_studentId", fields: [studentId], references: [id], onDelete: Restrict)
  version      Int
  text         String
  late         Boolean        @default(false)
  submittedAt  DateTime       @default(now())

  @@unique([assignmentId, studentId, version])
  @@index([offeringId])
  @@index([assignmentId])
  @@index([studentId])
}

model SubmissionFile {
  id           String     @id @default(uuid()) @db.Uuid
  academyId    String     @db.Uuid
  offeringId   String     @db.Uuid
  studentId    String     @db.Uuid
  submissionId String     @db.Uuid
  submission   Submission @relation("SubmissionFile_submissionId", fields: [submissionId], references: [id], onDelete: Restrict)
  materialId   String     @db.Uuid
  material     Material   @relation("SubmissionFile_materialId", fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([submissionId, materialId])
  @@index([submissionId])
}

model Feedback {
  id           String     @id @default(uuid()) @db.Uuid
  academyId    String     @db.Uuid
  offeringId   String     @db.Uuid
  submissionId String     @db.Uuid
  submission   Submission @relation("Feedback_submissionId", fields: [submissionId], references: [id], onDelete: Restrict)
  version      Int
  authorId     String     @db.Uuid
  author       User       @relation("Feedback_authorId", fields: [authorId], references: [id], onDelete: Restrict)
  text         String
  createdAt    DateTime   @default(now())

  @@unique([submissionId, version])
  @@index([submissionId])
  @@index([authorId])
}

model Review {
  reports ReviewReport[] @relation("ReviewReport_reviewId")

  id            String     @id @default(uuid()) @db.Uuid
  enrollmentId  String     @unique @db.Uuid
  enrollment    Enrollment @relation("Review_enrollmentId", fields: [enrollmentId], references: [id], onDelete: Restrict)
  authorId      String     @db.Uuid
  author        User       @relation("Review_authorId", fields: [authorId], references: [id], onDelete: Restrict)
  rating        Int
  text          String
  hiddenAt      DateTime?
  hiddenReason  String?
  moderatedById String?    @db.Uuid
  moderator     User?      @relation("Review_moderatedById", fields: [moderatedById], references: [id], onDelete: Restrict)
  createdAt     DateTime   @default(now())

  @@index([authorId])
  @@index([moderatedById])
}

model ReviewReport {
  id               String    @id @default(uuid()) @db.Uuid
  reviewId         String    @db.Uuid
  review           Review    @relation("ReviewReport_reviewId", fields: [reviewId], references: [id], onDelete: Restrict)
  reporterId       String    @db.Uuid
  reporter         User      @relation("ReviewReport_reporterId", fields: [reporterId], references: [id], onDelete: Restrict)
  reason           String
  status           String    @default("open")
  resolution       String?
  resolutionReason String?
  resolvedById     String?   @db.Uuid
  resolver         User?     @relation("ReviewReport_resolvedById", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@unique([reviewId, reporterId])
  @@index([reviewId])
  @@index([reporterId])
  @@index([resolvedById])
}

model AnalyticsEvent {
  id           String      @id @default(uuid()) @db.Uuid
  academyId    String?     @db.Uuid
  academy      Academy?    @relation("AnalyticsEvent_academyId", fields: [academyId], references: [id], onDelete: Restrict)
  offeringId   String?     @db.Uuid
  offering     Offering?   @relation("AnalyticsEvent_offeringId", fields: [offeringId], references: [id], onDelete: Restrict)
  orderId      String?     @db.Uuid
  order        Order?      @relation("AnalyticsEvent_orderId", fields: [orderId], references: [id], onDelete: Restrict)
  enrollmentId String?     @db.Uuid
  enrollment   Enrollment? @relation("AnalyticsEvent_enrollmentId", fields: [enrollmentId], references: [id], onDelete: Restrict)
  actorId      String?     @db.Uuid
  actor        User?       @relation("AnalyticsEvent_actorId", fields: [actorId], references: [id], onDelete: Restrict)
  stage        String
  dedupeKey    String      @unique
  createdAt    DateTime    @default(now())

  @@index([academyId])
  @@index([offeringId])
  @@index([orderId])
  @@index([enrollmentId])
  @@index([actorId])
}
