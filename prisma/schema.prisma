generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique
  platformAdmin         Boolean                @default(false)
  guardianVerifiedAt    DateTime?
  disabledAt            DateTime?
  createdAt             DateTime               @default(now())
  memberships           AcademyMembership[]
  guardianLinks         GuardianLink[]
  student               StudentProfile?
  assignments           InstructorAssignment[]
  studentInvitations    StudentInvitation[]
  instructorInvitations InstructorInvitation[]
  orders                Order[]
}

model Academy {
  orders                Order[]
  settlementEntries     SettlementEntry[]
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  region                String
  status                String                 @default("draft")
  decisionReason        String?
  createdAt             DateTime               @default(now())
  memberships           AcademyMembership[]
  courses               Course[]
  offerings             Offering[]
  instructorInvitations InstructorInvitation[]

  @@index([status, createdAt])
}

model AcademyMembership {
  id        String  @id @default(uuid()) @db.Uuid
  academyId String  @db.Uuid
  userId    String  @db.Uuid
  role      String
  active    Boolean @default(true)
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Restrict)
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([academyId, userId])
  @@index([userId, active])
}

model StudentProfile {
  orders        Order[]
  id            String              @id @default(uuid()) @db.Uuid
  name          String
  grade         Int
  accountUserId String?             @unique @db.Uuid
  account       User?               @relation(fields: [accountUserId], references: [id], onDelete: Restrict)
  guardians     GuardianLink[]
  invitations   StudentInvitation[]
  enrollments   Enrollment[]
  createdAt     DateTime            @default(now())
}

model GuardianLink {
  id         String         @id @default(uuid()) @db.Uuid
  guardianId String         @db.Uuid
  studentId  String         @db.Uuid
  verifiedAt DateTime
  revokedAt  DateTime?
  guardian   User           @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([guardianId, studentId])
  @@index([studentId, revokedAt])
}

model StudentInvitation {
  id             String         @id @default(uuid()) @db.Uuid
  studentId      String         @db.Uuid
  issuedById     String         @db.Uuid
  recipientEmail String
  tokenHash      String         @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  issuer         User           @relation(fields: [issuedById], references: [id], onDelete: Restrict)

  @@index([studentId, expiresAt])
  @@index([issuedById])
}

model InstructorInvitation {
  issuedById     String    @db.Uuid
  issuer         User      @relation(fields: [issuedById], references: [id], onDelete: Restrict)
  id             String    @id @default(uuid()) @db.Uuid
  academyId      String    @db.Uuid
  recipientEmail String
  tokenHash      String    @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  academy        Academy   @relation(fields: [academyId], references: [id], onDelete: Restrict)

  @@index([academyId, expiresAt])
}

model Course {
  id        String     @id @default(uuid()) @db.Uuid
  academyId String     @db.Uuid
  title     String
  subject   String
  gradeMin  Int
  gradeMax  Int
  level     String
  academy   Academy    @relation(fields: [academyId], references: [id], onDelete: Restrict)
  offerings Offering[]

  @@unique([id, academyId])
  @@index([academyId])
}

model Offering {
  orders             Order[]
  id                 String                 @id @default(uuid()) @db.Uuid
  courseId           String                 @db.Uuid
  academyId          String                 @db.Uuid
  status             String                 @default("draft")
  priceWon           Int
  capacity           Int
  enrollmentOpensAt  DateTime
  enrollmentClosesAt DateTime
  purchaseLockedAt   DateTime?
  createdAt          DateTime               @default(now())
  course             Course                 @relation(fields: [courseId, academyId], references: [id, academyId], onDelete: Restrict)
  academy            Academy                @relation(fields: [academyId], references: [id], onDelete: Restrict)
  sessions           Session[]
  instructors        InstructorAssignment[]
  enrollments        Enrollment[]

  @@unique([id, academyId])
  @@index([academyId, status])
  @@index([status, enrollmentClosesAt, id])
  @@index([courseId, academyId])
}

model Session {
  enrollmentSessions EnrollmentSession[]
  id                 String              @id @default(uuid()) @db.Uuid
  offeringId         String              @db.Uuid
  academyId          String              @db.Uuid
  startsAt           DateTime
  endsAt             DateTime
  offering           Offering            @relation(fields: [offeringId, academyId], references: [id, academyId], onDelete: Restrict)

  @@index([offeringId, academyId])
  @@index([startsAt, endsAt])
}

model InstructorAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  offeringId String   @db.Uuid
  userId     String   @db.Uuid
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  instructor User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([offeringId, userId])
  @@index([userId])
}

model Enrollment {
  orderId    String?             @unique @db.Uuid
  order      Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sessions   EnrollmentSession[]
  id         String              @id @default(uuid()) @db.Uuid
  offeringId String              @db.Uuid
  studentId  String              @db.Uuid
  status     String              @default("active")
  offering   Offering            @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  student    StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([offeringId, studentId])
  @@index([studentId, status])
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  action    String
  targetId  String
  reason    String?
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
}

model RateLimit {
  key       String   @id
  hits      Int
  expiresAt DateTime
}

model RecommendationEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @db.Uuid
  ruleVersion  String
  candidateIds String[]
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
}

model Order {
  id                String            @id @default(uuid()) @db.Uuid
  parentId          String            @db.Uuid
  studentId         String            @db.Uuid
  offeringId        String            @db.Uuid
  academyId         String            @db.Uuid
  requestKey        String
  status            String            @default("pending_payment")
  amountWon         Int
  currency          String            @default("KRW")
  feeWon            Int
  policyVersion     String
  policySnapshot    Json
  sessionsSnapshot  Json
  consentedAt       DateTime?
  expiresAt         DateTime
  exceptionReason   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  parent            User              @relation(fields: [parentId], references: [id], onDelete: Restrict)
  student           StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  offering          Offering          @relation(fields: [offeringId, academyId], references: [id, academyId], onDelete: Restrict)
  academy           Academy           @relation(fields: [academyId], references: [id], onDelete: Restrict)
  reservation       SeatReservation?
  enrollment        Enrollment?
  payment           Payment?
  refunds           Refund[]
  settlementEntries SettlementEntry[]

  @@unique([parentId, requestKey])
  @@unique([id, studentId, offeringId, academyId])
  @@index([parentId, createdAt, id])
  @@index([studentId, status])
  @@index([offeringId, academyId, status])
  @@index([status, expiresAt])
  @@index([academyId, status])
}

model SeatReservation {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @unique @db.Uuid
  studentId  String   @db.Uuid
  offeringId String   @db.Uuid
  academyId  String   @db.Uuid
  status     String   @default("held")
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId, studentId, offeringId, academyId], references: [id, studentId, offeringId, academyId], onDelete: Restrict)

  @@unique([orderId, studentId, offeringId, academyId])
  @@index([offeringId, status, expiresAt])
  @@index([studentId, status, expiresAt])
}

model EnrollmentSession {
  id           String          @id @default(uuid()) @db.Uuid
  enrollmentId String          @db.Uuid
  sessionId    String          @db.Uuid
  status       String          @default("allowed")
  startsAt     DateTime
  endsAt       DateTime
  amountWon    Int
  completedAt  DateTime?
  enrollment   Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  session      Session         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  refunds      RefundSession[]

  @@unique([enrollmentId, sessionId])
  @@index([sessionId])
}

model Payment {
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @unique @db.Uuid
  provider          String            @default("fake")
  transactionId     String            @unique
  amountWon         Int
  currency          String            @default("KRW")
  status            String            @default("pending")
  verifiedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds           Refund[]
  settlementEntries SettlementEntry[]

  @@index([status, updatedAt])
}

model Refund {
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @db.Uuid
  paymentId         String            @db.Uuid
  requestKey        String            @unique
  requestedById     String?           @db.Uuid
  kind              String            @default("customer")
  status            String            @default("requested")
  amountWon         Int
  reason            String
  providerReference String?
  attempts          Int               @default(0)
  lastError         String?
  succeededAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment           Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  sessions          RefundSession[]
  settlementEntries SettlementEntry[]

  @@index([orderId, status])
  @@index([paymentId, status])
  @@index([status, updatedAt])
}

model RefundSession {
  id                  String            @id @default(uuid()) @db.Uuid
  refundId            String            @db.Uuid
  enrollmentSessionId String            @db.Uuid
  refund              Refund            @relation(fields: [refundId], references: [id], onDelete: Restrict)
  enrollmentSession   EnrollmentSession @relation(fields: [enrollmentSessionId], references: [id], onDelete: Restrict)

  @@unique([refundId, enrollmentSessionId])
  @@index([enrollmentSessionId])
}

model ProviderEvent {
  id            String    @id @default(uuid()) @db.Uuid
  provider      String    @default("fake")
  eventId       String    @unique
  transactionId String
  status        String    @default("pending")
  payloadJson   Json
  attempts      Int       @default(0)
  lastError     String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([status, createdAt])
  @@index([transactionId])
}

model SettlementEntry {
  id                String            @id @default(uuid()) @db.Uuid
  academyId         String            @db.Uuid
  orderId           String            @db.Uuid
  paymentId         String?           @db.Uuid
  refundId          String?           @db.Uuid
  kind              String
  amountWon         Int
  currency          String            @default("KRW")
  idempotencyKey    String            @unique
  originalEntryId   String?           @db.Uuid
  externalReference String?
  recordedById      String?           @db.Uuid
  createdAt         DateTime          @default(now())
  academy           Academy           @relation(fields: [academyId], references: [id], onDelete: Restrict)
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment           Payment?          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund            Refund?           @relation(fields: [refundId], references: [id], onDelete: Restrict)
  originalEntry     SettlementEntry?  @relation("LedgerOriginal", fields: [originalEntryId], references: [id], onDelete: Restrict)
  adjustments       SettlementEntry[] @relation("LedgerOriginal")

  @@index([academyId, createdAt, id])
  @@index([orderId])
  @@index([paymentId])
  @@index([refundId])
  @@index([originalEntryId])
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  status      String    @default("pending")
  dedupeKey   String    @unique
  payloadJson Json
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  leaseUntil  DateTime?
  claimedBy   String?
  claimToken  String?   @db.Uuid
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([status, leaseUntil])
}
